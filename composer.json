{
    "name": "ai-banking/grc-platform",
    "description": "Enterprise AI-powered Governance, Risk & Compliance (GRC) Platform for Pakistani Banks",
    "type": "project",
    "keywords": [
        "grc",
        "banking",
        "compliance",
        "risk",
        "audit",
        "ai",
        "pakistan",
        "sbp",
        "iso27001",
        "basel3",
        "nist"
    ],
    "homepage": "https://grc-platform.com",
    "license": "MIT",
    "authors": [
        {
            "name": "AI Banking GRC Platform Team",
            "email": "support@grc-platform.com",
            "homepage": "https://grc-platform.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "support@grc-platform.com",
        "issues": "https://github.com/yourusername/AI-Banking-GRC-Platform/issues",
        "wiki": "https://github.com/yourusername/AI-Banking-GRC-Platform/wiki",
        "source": "https://github.com/yourusername/AI-Banking-GRC-Platform"
    },
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-mysqli": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.14",
        "roave/security-advisories": "dev-master"
    },
    "suggest": {
        "ext-gd": "Required for image processing",
        "ext-zip": "Required for zip file handling",
        "ext-xml": "Required for XML parsing"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-update-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html reports/coverage",
        "cs-check": "phpcs --standard=PSR12 app/ modules/ tests/",
        "cs-fix": "phpcbf --standard=PSR12 app/ modules/ tests/",
        "stan": "phpstan analyse app/ modules/ --level=5",
        "dev": "php -S localhost:8080 -t public/",
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.0.0"
}